ERP_APP_NAME=erp
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/erp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=erp
# Set a strong local value; use the same value for DB_PASSWORD and MYSQL_PASSWORD.
DB_PASSWORD=replace-with-a-local-password
MYSQL_DATABASE=erp
MYSQL_USER=erp
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-local-password
MYSQL_PORT=3306
ERP_AUTH_TOKEN_HOURS=24
ERP_SEED_ADMIN_USERNAME=
ERP_SEED_ADMIN_PASSWORD=
ERP_SEED_ADMIN_REAL_NAME=
ERP_SEED_ADMIN_EMPLOYEE_NO=
ERP_REQUEST_ID_HEADER=X-Request-Id
